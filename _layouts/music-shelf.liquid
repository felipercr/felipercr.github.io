---
layout: page
---
{{ content }}

{% if page.collection and page.collection.size > 0 %}
  {% assign collection = site[page.collection] %}
  {% if collection and collection.size > 0 %}
    <ul>
    {% for item in collection reversed %}
      <figure class="cover">
        {% if item.spotify_url %}
          <a class="cover-link" href="{{ item.spotify_url }}" target="_blank" rel="noopener noreferrer">
        {% else %}
          <div class="cover-link">
        {% endif %}
          {% if item.cover %}
            <img alt="{{ item.title }}" src="{{ item.cover | prepend: page.covers | relative_url }}" style="height:200px">
          {% endif %}
        {% if item.spotify_url %}
          </a>
        {% else %}
          </div>
        {% endif %}
      </figure>
    {% endfor %}
    </ul>
  {% endif %}
{% endif %}
